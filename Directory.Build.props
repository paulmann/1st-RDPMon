<Project>
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisMode>All</AnalysisMode>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<LangVersion>latest</LangVersion>
		<Optimize Condition="'$(Configuration)'=='Release'">true</Optimize>
		<Authors>Mikhail Deynekin</Authors>
		<Company>Mikhail Deynekin (https://Deynekin.com)</Company>
		<Product>RdpAudit</Product>
		<Copyright>Copyright (c) Mikhail Deynekin</Copyright>
		<!-- Central version surface. publish.ps1 -p:VersionPrefix overrides this for releases;
		     the default below ensures the assembly version embedded in the binary is something
		     other than the implicit 1.0.0.0 placeholder so the Service tab can distinguish
		     runtime / installed / distribution binaries by version. Pinned to 1.3.3 for the
		     current release stream — see RdpAuditVersionMetadataTests for the gate. The 1.3.3
		     release makes the service crash-proof and observable: a durable OperationLogs subsystem
		     (program-action audit trail with severity / source / operation indexes and bounded
		     retention), a process-wide CrashGuard that records unhandled faults to an OperationLog /
		     Windows Event Log / fallback file instead of dying silently, and resilient background
		     workers that log Critical and continue instead of tearing down the host. The Configurator
		     gains a Logs tab (paged, filtered, DEBUG-detail), a global DEBUG toggle in Settings (with a
		     destructive-actions warning and a status indicator) that gates the Firewall maintenance
		     buttons, and an Overview historical-analysis progress bar so the UI opens immediately on a
		     large database. Two append-only IPC commands (QueryOperationLogs=58, GetOverviewProgress=59)
		     back these. It carries forward the 1.3.2 guarded cleanup operations, the 1.3.1 firewall
		     Remove / Repair / diagnostics stabilization and the 1.3.0 IPC reliability overhaul. -->
		<VersionPrefix Condition="'$(VersionPrefix)' == ''">1.3.3</VersionPrefix>
		<FileVersion>$(VersionPrefix).0</FileVersion>
		<AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
		<!-- Build SHA surface: when the build/publish pipeline passes -p:SourceRevisionId=<short-sha>
		     the SHA is appended as SemVer build metadata (after '+'), so the Service / Tools Diag report
		     can show exactly which commit produced the running binary. It defaults to empty so local and
		     test builds keep InformationalVersion == VersionPrefix exactly (RdpAuditVersionMetadataTests
		     trims any '+meta' suffix but also forbids legacy version substrings; keeping the SHA out of
		     non-pipeline builds avoids any rare short-SHA collision with those substrings). -->
		<SourceRevisionId Condition="'$(SourceRevisionId)' == ''"></SourceRevisionId>
		<!-- We compose the '+<sha>' SemVer build-metadata suffix ourselves below. With this left at its
		     default (true), the SDK appends '.<SourceRevisionId>' to InformationalVersion a SECOND time,
		     producing a duplicated suffix such as '1.3.1+abc123def456.abc123def456' — the historic
		     ProductVersion duplication. Disabling the automatic append leaves exactly one well-formed
		     '+<sha>' suffix produced by the conditional InformationalVersion below. -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<InformationalVersion Condition="'$(SourceRevisionId)' == ''">$(VersionPrefix)</InformationalVersion>
		<InformationalVersion Condition="'$(SourceRevisionId)' != ''">$(VersionPrefix)+$(SourceRevisionId)</InformationalVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<InvariantGlobalization>false</InvariantGlobalization>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<NoWarn>$(NoWarn);CA1014;CA1303;CA1305;CA1307;CA1308;CA1310;CA1812;CA1848;CA2007;CA2227;CA1002;CA1056;CA1054;CA1024;CA1716;CA1819;CA5394;CA1031;CA1062;CA1822;CA2208;CA1721;CA1304;CA1819;CA1707;CA1851;CA2000;CA1063;CA1816;CA1051;CA1050;CA1034;CA1724;CA1720;CA1727;CA2254;CA5379;CA1845;CA1860;CA1864;CA1873;CA1869;CA2249;CA1725;CA5392;CA1032;CA1064;CA2201;CA1018;CA1810;CA1873;CA1872;CA2249;CA1820;CA1829;CA1854;CA1867;CA1865;CA1866;CA2208;CA5350;CA5351;CA5359;CA5404;CA1052;CA2249;CA1715;CA1838;CA2213;CA1849;CA1861</NoWarn>
	</PropertyGroup>
</Project>
